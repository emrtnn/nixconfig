* {
    background: #282828;
    surface: #3c3836;
    foreground: #ebdbb2;
    muted: #a89984;
    accent: #d79921;
    urgent: #ad401f;
    font: "GeistMono Nerd Font Mono 10";
    background-color: @surface;
    text-color: @foreground;
}

window {
    width: 560px;
    border: 1px;
    border-color: @accent;
    border-radius: 12px;
    padding: 12px;
    background-color: @surface;
}

mainbox {
    spacing: 10px;
}

inputbar {
    padding: 8px;
    spacing: 8px;
    children: [ prompt, entry ];
    background-color: @background;
    border-radius: 8px;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Search";
    placeholder-color: @muted;
}

listview {
    lines: 8;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 7px;
    spacing: 8px;
    border-radius: 8px;
}

element-icon {
    size: 18px;
}

element selected.normal, element selected.active {
    background-color: @accent;
    text-color: @background;
}

element selected.urgent {
    background-color: @urgent;
    text-color: #fbf1c7;
}
