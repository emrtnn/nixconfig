# Directional focus, swap, and the next visible window on this desktop.
super + h
    bspc node -f west
super + j
    bspc node -f south
super + k
    bspc node -f north
super + l
    bspc node -f east
super + Left
    bspc node -f west
super + Down
    bspc node -f south
super + Up
    bspc node -f north
super + Right
    bspc node -f east
super + Tab
    bspc node -f next.local.!hidden.window
super + shift + h
    bspc node -s west
super + shift + j
    bspc node -s south
super + shift + k
    bspc node -s north
super + shift + l
    bspc node -s east
super + shift + Left
    bspc node -s west
super + shift + Down
    bspc node -s south
super + shift + Up
    bspc node -s north
super + shift + Right
    bspc node -s east

# Window state, split orientation, and layout.
super + q
    bspc node -c
super + t
    bspc node -t '~floating'
super + F5
    bspc node -t '~fullscreen'
super + n
    bspc desktop -l next
super + o
    if bspc query -N -n focused.tiled >/dev/null 2>&1 && \
       bspc query -N -n @parent >/dev/null 2>&1; then \
        bspc node @parent -y next; \
    fi
super + alt + o
    if bspc query -N -n focused.tiled >/dev/null 2>&1 && \
       bspc query -N -n @parent >/dev/null 2>&1; then \
        bspc node @parent -y horizontal; \
    fi
super + alt + shift + o
    if bspc query -N -n focused.tiled >/dev/null 2>&1 && \
       bspc query -N -n @parent >/dev/null 2>&1; then \
        bspc node @parent -y vertical; \
    fi
super + alt + {h,l}
    if bspc query -N -n 'focused.window.!fullscreen' >/dev/null 2>&1 && \
       bspc query -N -n @parent >/dev/null 2>&1; then \
        d={40,-40}; \
        if bspc query -N -n focused.tiled >/dev/null 2>&1; then \
            bspc node -z right "$d" 0 2>/dev/null || \
                bspc node -z left "$((-d))" 0 2>/dev/null || :; \
        else \
            bspc node -z right "$((d * 4))" 0; \
        fi; \
    fi
super + alt + {k,j}
    if bspc query -N -n 'focused.window.!fullscreen' >/dev/null 2>&1 && \
       bspc query -N -n @parent >/dev/null 2>&1; then \
        d={40,-40}; \
        if bspc query -N -n focused.tiled >/dev/null 2>&1; then \
            bspc node -z bottom 0 "$d" 2>/dev/null || \
                bspc node -z top 0 "$((-d))" 2>/dev/null || :; \
        else \
            bspc node -z bottom 0 "$((d * 4))"; \
        fi; \
    fi

# Named desktops; send the current client and follow it for Shift/Ctrl moves.
super + 1
    bspc desktop -f 1
super + 2
    bspc desktop -f 2
super + 3
    bspc desktop -f 3
super + 4
    bspc desktop -f 4
super + 5
    bspc desktop -f 5
super + 6
    bspc desktop -f 6
super + 7
    bspc desktop -f 7
super + 8
    bspc desktop -f 8
super + 9
    bspc desktop -f 9
super + shift + 1
    bspc node -d 1 --follow
super + shift + 2
    bspc node -d 2 --follow
super + shift + 3
    bspc node -d 3 --follow
super + shift + 4
    bspc node -d 4 --follow
super + shift + 5
    bspc node -d 5 --follow
super + shift + 6
    bspc node -d 6 --follow
super + shift + 7
    bspc node -d 7 --follow
super + shift + 8
    bspc node -d 8 --follow
super + shift + 9
    bspc node -d 9 --follow
super + ctrl + Left
    bspc node -d prev.local --follow
super + ctrl + Right
    bspc node -d next.local --follow
super + button4
    bspc desktop -f prev.local.occupied
super + button5
    bspc desktop -f next.local.occupied

# Screenshots, password store, and persistent pentest target.
super + s
    nixconfig-screenshot region-edit
super + shift + s
    nixconfig-screenshot full-edit
Print
    nixconfig-screenshot region-copy
shift + Print
    nixconfig-screenshot full-save
super + alt + p
    passmenu -i -l 10 -p Passwords -fn 'GeistMono Nerd Font Mono-10' -nb '#282828' -nf '#ebdbb2' -sb '#d79921' -sf '#282828'
super + alt + t
    argos-target menu

# PipeWire and playback controls.
XF86AudioRaiseVolume
    wpctl set-volume --limit 1.0 @DEFAULT_AUDIO_SINK@ 5%+
XF86AudioLowerVolume
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
XF86AudioMute
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
XF86AudioNext
    playerctl next
XF86AudioPause
    playerctl stop
XF86AudioPlay
    playerctl play-pause
XF86AudioPrev
    playerctl previous
