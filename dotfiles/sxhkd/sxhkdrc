# Session and applications
super + Return
    kitty
super + f
    kitty --class monad.yazi -e yazi
super + shift + f
    nautilus --new-window
super + space
    rofi -show drun
super + comma
    argos-menu controls
super + shift + space
    argos-menu controls
super + shift + v
    copyq toggle
super + @c
    xdotool key --clearmodifiers ctrl+Insert
super + @v
    xdotool key --clearmodifiers shift+Insert
super + @x
    xdotool key --clearmodifiers ctrl+x
super + shift + Escape
    argos-menu lock
super + shift + q
    bspc quit
super + shift + r
    kill -USR1 "$SXHKD_PID" && bspc wm -r

